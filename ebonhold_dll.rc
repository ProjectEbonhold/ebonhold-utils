// Version resource for ebonhold.dll. A populated VERSIONINFO block makes the
// binary read as normal shipped software instead of a metadata-less blob, which
// lowers ML/heuristic AV scores. Bump the versions on each release.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Async Studio"
            VALUE "FileDescription",  "Ebonhold client extension"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "ebonhold.dll"
            VALUE "OriginalFilename", "ebonhold.dll"
            VALUE "ProductName",      "Ebonhold"
            VALUE "ProductVersion",   "1.0.0.0"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Async Studio"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
